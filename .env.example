# ===== 自托管部署 =====
# 你的域名（需已解析到服务器 IP）
DOMAIN=checkin.example.com
# 会话签名密钥，用 `openssl rand -hex 32` 生成一段随机字符串
SESSION_SECRET=please-generate-a-long-random-string
# 推送通知的邮件主题（无需真实邮箱，格式需为 mailto:xxx）
VAPID_SUBJECT=mailto:admin@example.com

# ===== 数据库（可选）=====
# 默认 SQLite（本地 data/habits.db）。要改用 Supabase/Postgres，填：
# DATABASE_URL=postgresql://postgres.<项目ref>:<密码>@aws-0-<区域>.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# ===== AI 分析（可选）=====
# OpenAI 兼容接口（可对接 OpenAI / DeepSeek / Moonshot / 智谱等）
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
